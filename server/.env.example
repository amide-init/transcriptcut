# Copy this file to .env and fill in the values below.
# Never commit your actual .env -- it's gitignored on purpose.
# Bun loads .env files natively -- no extra setup needed.

# Required. Used server-side only (transcription via Whisper, and any
# future AI editing calls) -- never exposed to the browser.
OPENAI_API_KEY=sk-...

# Resolved relative to the working directory the app runs from (server/).
DATABASE_URL="file:./data/app.db"

# Root directory for all local project data (uploads, transcripts, renders).
DATA_DIR="./data"

# Port the Hono/Bun server listens on. The Vite client's dev server proxies
# /api/* requests here (see client/vite.config.ts).
PORT=3001

# Origin allowed to make cross-origin requests in dev (the Vite dev
# server). Not needed once client and server are served from the same
# origin in production.
CORS_ORIGIN="http://localhost:5173"

# Optional. Overrides the `ffmpeg` binary used for rendering. Only needed
# if your default `ffmpeg` lacks libass (subtitle burn-in support) -- on
# Homebrew, `brew install ffmpeg-full` gets you one that has it, and this
# points at it instead of the default `ffmpeg` on PATH. Without this,
# "Burn in captions" will fail with "No such filter: 'subtitles'" if your
# default ffmpeg build doesn't include libass.
# FFMPEG_PATH="/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg"
